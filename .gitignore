# Go
/bin/
*.test
*.out

# Node
node_modules/
ui/dist/
ui/.vite/
# `npm run typecheck` runs `tsc -b` first, which EMITS .js next to every source
# before falling back to --noEmit. Those artifacts are not source and must never
# be committed: a stale compiled copy alongside its .tsx is exactly the kind of
# file someone later edits by mistake.
ui/*.tsbuildinfo
ui/src/**/*.js
ui/src/**/*.js.map
ui/vite.config.js
ui/vitest.config.js

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local
.env
.env.local
*.log
.DS_Store
gpt_architecture.zip

# nexusctl build output and the SDK test venv
/nexusctl
.venv-sdk/
deploy/.env

# Compiled service binaries: build output, not source. `scheduler` was
# committed once at 24MB; it stays in history but must not accumulate.
/scheduler
