# Go
/bin/
*.test
*.out

# Node
node_modules/
ui/dist/
ui/.vite/
# `npm run typecheck` runs `tsc -b` first, which EMITS .js next to every source
# before falling back to --noEmit. Those artifacts are not source and must never
# be committed: a stale compiled copy alongside its .tsx is exactly the kind of
# file someone later edits by mistake.
ui/*.tsbuildinfo
ui/src/**/*.js
ui/src/**/*.js.map
ui/vite.config.js
ui/vitest.config.js

# Python
__pycache__/
.mypy_cache/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local
.env
.env.local
*.log
.DS_Store
gpt_architecture.zip
# Drill reports (make restore-drill / pitr-drill): per-run output, not source.
/restore-drill-report.json
/pitr-drill-report.json

# nexusctl build output and the SDK test venv
/nexusctl
.venv-sdk/
deploy/.env

# Compiled service binaries: build output, not source. `scheduler` was
# committed once at 24MB; it stays in history but must not accumulate.
/scheduler
# Anchored to the repository root on purpose. Unanchored, `cmd` matches EVERY
# directory named cmd at any depth -- which is every service's source entry
# point (services/*/cmd/<name>, agent/cmd, cli/cmd). The already-tracked ones
# kept working because .gitignore does not affect tracked files, so the breakage
# was invisible: only NEWLY added commands silently failed to appear in
# `git status`. The root `cmd` file this targets is a scratch credentials dump,
# not a directory.
/cmd

# Locally generated TLS material (`make dev-certs`, deploy/nexus-certs.sh). It
# holds a CA private key: never commit it, and never copy it off the laptop.
/.dev-certs/

# NATS NKey seeds (deploy/nats/nexus-nats-auth.sh, `make k8s-dev-up`). Never commit.
/.dev-nats/
