{
  "realm": "nexus-e2e",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "groups": [
    { "name": "nexus-operators" },
    { "name": "staff" }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@acme.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice-e2e-password", "temporary": false }],
      "groups": ["/nexus-operators"]
    },
    {
      "username": "bob",
      "email": "bob@acme.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob-e2e-password", "temporary": false }],
      "groups": ["/staff"]
    },
    {
      "username": "mallory",
      "email": "mallory@acme.test",
      "emailVerified": false,
      "firstName": "Mallory",
      "lastName": "Unverified",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "mallory-e2e-password", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "nexus-oidc",
      "name": "Nexus console (OIDC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "nexus-oidc-e2e-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:55813/v1/auth/sso/oidc/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:55813/login?signed_out=1"
      },
      "defaultClientScopes": ["openid", "email", "profile"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
