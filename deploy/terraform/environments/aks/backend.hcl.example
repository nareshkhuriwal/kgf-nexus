# Copy to backend.hcl (gitignored) and run: terraform init -backend-config=backend.hcl
# Create the state storage account once, by hand or from a bootstrap stack:
# private, versioning + soft delete on, shared keys off, RBAC "Storage Blob
# Data Contributor" for the deployers only.
resource_group_name  = "kgf-nexus-tfstate-rg"
storage_account_name = "kgfnexustfstate"
container_name       = "tfstate"
key                  = "aks/kgf-nexus-prod.tfstate"
use_azuread_auth     = true
