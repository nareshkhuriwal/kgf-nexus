# Multi-stage build for ALL six Go control-plane services and the agent.
#
# One parameterised Dockerfile rather than seven near-identical ones: the build
# is byte-identical per service apart from the package path, and seven copies of
# the same file drift the moment someone bumps a Go version in six of them.
# `SERVICE` selects which main package to compile.
#
# Build context is the REPO ROOT, because the module lives there and every
# service imports internal/ and gen/. Building from services/<name>/ would put
# the shared packages outside the context.
#
#   docker build -f deploy/Dockerfile.service --build-arg SERVICE=scheduler .

ARG GO_VERSION=1.25

# ── build ─────────────────────────────────────────────────────────────────
FROM golang:${GO_VERSION}-alpine AS build

# git is needed by `go mod download` for any VCS-resolved dependency.
RUN apk add --no-cache git ca-certificates

WORKDIR /src

# Dependencies are copied and downloaded first so an edit to any .go file
# reuses the cached module layer instead of re-downloading the whole graph.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# SERVICE is the directory under services/ (or "agent" for the worker agent).
ARG SERVICE
ARG SERVICE_PATH
ARG VERSION=dev

# CGO off => a static binary that runs in a scratch/alpine image with no libc
# dependency, which is the whole reason the agent is shippable as one file.
# -trimpath keeps build paths out of the binary so images are reproducible.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/service \
      ./${SERVICE_PATH:-services/${SERVICE}}

# ── runtime ───────────────────────────────────────────────────────────────
FROM alpine:3.21 AS runtime

# wget is present in busybox and is what the compose healthchecks use to probe
# /healthz; ca-certificates is needed for any outbound TLS (MinIO over https).
RUN apk add --no-cache ca-certificates tzdata \
 && adduser -D -u 10001 nexus

# The worker agent's docker executor drives the Docker CLI (agent/internal/
# executor/docker.go) and advertises the executor only when `docker info`
# succeeds. Without the CLI the compose agents silently ran subprocess-only,
# and every task with runtime.executor=docker -- including every nexusctl init
# template -- waited unplaced forever (F144). bash is there for subprocess
# tasks that need it: Airflow BashOperator commands converted by
# `nexusctl import airflow` run as `bash -c`, and busybox sh is not bash.
# Only the agent image gets either.
ARG SERVICE
RUN if [ "$SERVICE" = "agent" ]; then apk add --no-cache docker-cli bash; fi

# --chmod is required: a plain COPY carries the build stage's mode bits, and the
# binary is then not executable by the unprivileged runtime user, which fails at
# container start with a bare "permission denied" that says nothing about why.
COPY --from=build --chmod=0755 /out/service /usr/local/bin/nexus-service

# The agent needs a writable WAL directory. Creating it in the image with the
# right owner means a named volume mounted here inherits that ownership, so the
# unprivileged user can write without the container needing root.
RUN mkdir -p /var/lib/nexus/wal /var/lib/nexus-agent/wal /var/lib/nexus/effects \
 && chown -R 10001:10001 /var/lib/nexus /var/lib/nexus-agent

# Never run the control plane as root: a compromised service should not be able
# to write outside its own container filesystem.
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/nexus-service"]
