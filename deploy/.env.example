# Copy to deploy/.env and edit. Every value here has a working default in
# docker-compose.yml, so this file is optional.
#
# These credentials are DEV-ONLY. There is no secret management in Phase 1;
# do not reuse any of these outside a laptop.

# Ports
NEXUS_UI_PORT=3000
NEXUS_API_PORT=8080
NEXUS_GRPC_PORT=9091
NEXUS_POSTGRES_PORT=55433
NEXUS_MINIO_PORT=9000
NEXUS_MINIO_CONSOLE_PORT=9001

# Single namespace for the MVP; multi-tenancy is Phase 2.
NEXUS_NAMESPACE=default
NEXUS_LOG_LEVEL=info

# Result store (ADR-0008). Bucket is auto-created by minio-init.
NEXUS_RESULT_BUCKET=nexus-results
MINIO_ROOT_USER=nexusadmin
MINIO_ROOT_PASSWORD=nexus-dev-password

# API keys. Change BOTH the value here and re-run `make seed`, or the agents
# will fail to register.
NEXUS_DEV_API_KEY=dev-admin-key
NEXUS_WORKER_API_KEY=dev-worker-key

# Advertised GPU model on agent-gpu. Advertised capacity is a ledger entry, not
# a hardware probe, so this works on a machine with no GPU.
NEXUS_GPU_KIND=nvidia-a100
