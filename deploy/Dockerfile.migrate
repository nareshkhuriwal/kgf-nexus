# SPDX-License-Identifier: Apache-2.0
#
# Migration job (ADR-0011 rule 4): schema migrations are applied by a DEDICATED
# JOB, never by a service at startup, because concurrent service replicas must
# not race to migrate.
#
# Deliberately a plain postgres-client image running psql rather than a Go
# migration binary. The migrations are ordered SQL files with no templating, and
# a job whose only dependency is psql cannot fail to start because the Go code
# it shares with the services does not compile yet — which matters during Phase
# 1 bring-up, where the services are still being written.

ARG GO_VERSION=1.25

# nexus-db-roles (services/db-roles): creates the per-service LOGIN roles as
# the chart's db-roles Job. Go, not psql, because it hashes each password into
# a SCRAM verifier client-side, which psql can only do interactively
# (\password); the plaintext then never reaches the server or its logs.
# Built on the builder's own platform and cross-compiled (CGO is off), so an
# amd64 image built on an arm64 Mac never runs the compiler under emulation.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY services/db-roles ./services/db-roles
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags "-s -w" -o /out/nexus-db-roles ./services/db-roles

FROM postgres:16-alpine

COPY --from=build --chmod=0755 /out/nexus-db-roles /usr/local/bin/nexus-db-roles

COPY --chmod=0755 deploy/migrate.sh /usr/local/bin/migrate.sh

# The same unprivileged uid as every other Nexus image, with a passwd entry so
# psql and libpq can name the OS user. Neither tool writes anything here: the
# DSN carries the login, and a TLS root bundle is mounted read-only.
RUN adduser -D -u 10001 nexus

# The migrations ship IN the image, versioned with the code that needs them.
# Compose also bind-mounts services/migrations over this path, which still wins
# locally; Kubernetes has no host path to mount, so a Job there runs exactly
# the set this image was built with -- which is the set that is safe to run.
COPY services/migrations /migrations
ENV MIGRATIONS_DIR=/migrations

# OCI labels (docs/IMAGES.md); the release workflow sets the same keys.
ARG VERSION=dev
ARG REVISION=""
ARG SOURCE=https://github.com/nareshkhuriwal/kgf-nexus
LABEL org.opencontainers.image.title="kgf-nexus/migrate" \
      org.opencontainers.image.description="KGF Nexus schema migrations (psql) and per-service database logins (nexus-db-roles)" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Khuriwal Group" \
      org.opencontainers.image.documentation="${SOURCE}/blob/main/docs/IMAGES.md"

# A Job, not a server: nothing listens (the 5432 EXPOSE and the data VOLUME
# are the postgres base image's, and cannot be removed). Runs to completion and
# exits 0, or non-zero with the reason; safe to re-run (applied versions are
# skipped). SIGTERM, not the base image's SIGINT (a server's fast shutdown).
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/migrate.sh"]
